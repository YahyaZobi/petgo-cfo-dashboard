function loadEmployees(){
  // Always start from DEFAULT_EMPLOYEES (hardcoded photos, IDs, contact info)
  var base=DEFAULT_EMPLOYEES.map(function(e){return Object.assign({},e);});
  try{
    var s=localStorage.getItem('petgo_employees');
    if(s){
      var d=JSON.parse(s);
      if(Array.isArray(d)&&d.length>0){
        // Build a map of localStorage entries by id
        var lsMap={};
        d.forEach(function(e){lsMap[e.id]=e;});
        // Merge: update base entries with localStorage edits, preserve DEFAULT photo if ls has none
        base=base.map(function(e){
          var ls=lsMap[e.id];
          if(ls) return Object.assign({},e,ls,{photo:ls.photo||e.photo});
          return e;
        });
        // Append any new employees added via the UI (not in DEFAULT)
        var baseIds=base.map(function(e){return e.id;});
        d.forEach(function(e){
          if(baseIds.indexOf(e.id)===-1) base.push(e);
        });
      }
    }
  }catch(ex){}
  // Auto-assign PTG-XXX empId if missing
  var changed=false;
  base.forEach(function(e){
    if(!e.empId){e.empId='PTG-'+String(e.id||0).padStart(3,'0');changed=true;}
  });
  employees=base;
  empNextId=Math.max.apply(null,employees.map(function(e){return e.id||0;}))+1;
  if(changed)saveEmployeeStore();
}

