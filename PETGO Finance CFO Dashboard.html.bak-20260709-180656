var pendingData=null;
var uploadedFiles=[]; // {name,size,ext,sheets,sheetNames}
var dynCC=0;

function handleDrop(e){e.preventDefault();document.getElementById('upload-zone').classList.remove('drag-over');var f=e.dataTransfer.files[0];if(f)processFile(f);}
function handleFileSelect(e){var f=e.target.files[0];if(f){processFile(f);e.target.value='';}}

function processFile(file){
  var ext=file.name.split('.').pop().toLowerCase();
  if(['xlsx','xls','csv'].indexOf(ext)<0){showToast('Unsupported type. Use .xlsx or .csv');return;}
  // Show processing state
  document.getElementById('upload-zone').style.opacity='0.4';
  document.getElementById('proc-msg').style.display='block';
  // Allow UI to update before heavy processing
  setTimeout(function(){
    if(ext==='csv'){
      var r=new FileReader(); r.readAsText(file);
      r.onload=function(ev){
        var rows=parseCSV(ev.target.result).slice(0,5001); // cap 5000 data rows
        pendingData={name:file.name,size:file.size,ext:ext,sheets:{'Sheet1':rows},sheetNames:['Sheet1']};
        doneLoading(); showPrev('Sheet1',rows.slice(0,6));
      };
    } else {
      if(typeof XLSX==='undefined'){doneLoading();showToast('Excel parser loading, try again.');return;}
      var r=new FileReader(); r.readAsArrayBuffer(file);
      r.onload=function(ev){
        try{
          var wb=XLSX.read(new Uint8Array(ev.target.result),{type:'array',sheetStubs:false});
          var sh={};
          wb.SheetNames.forEach(function(n){
            var raw=XLSX.utils.sheet_to_json(wb.Sheets[n],{header:1,defval:null,blankrows:false});
            sh[n]=raw.slice(0,5001); // cap 5000 data rows + 1 header
          });
          pendingData={name:file.name,size:file.size,ext:ext,sheets:sh,sheetNames:wb.SheetNames};
          doneLoading(); showPrev(wb.SheetNames[0],sh[wb.SheetNames[0]].slice(0,6));
        }catch(er){doneLoading();showToast('Error reading file: '+er.message);}
      };
    }
  },60);
}

function doneLoading(){
  document.getElementById('upload-zone').style.opacity='';
  document.getElementById('proc-msg').style.display='none';
}

function parseCSV(t){
  return t.trim().split(/\r?\n/).map(function(l){
    var result=[],cur='',inQ=false;
    for(var i=0;i<l.length;i++){var c=l[i];if(c==='"'){inQ=!inQ;}else if(c===','&&!inQ){result.push(cur.trim());cur='';}else{cur+=c;}}
    result.push(cur.trim()); return result;
  });
}

function showPrev(name,rows){
  if(!rows||!rows.length)return;
  var h=rows[0];var dr=rows.slice(1);
  var html='<thead><tr>'+h.map(function(c){return '<th>'+escH(String(c||''))+'</th>';}).join('')+'</tr></thead><tbody>';
  dr.slice(0,5).forEach(function(row){html+='<tr>'+h.map(function(_,i){return '<td>'+escH(String(row[i]!=null?row[i]:''))+'</td>';}).join('')+'</tr>';});
  html+='</tbody>';
  document.getElementById('prev-title').textContent='Data Preview — '+name;
  document.getElementById('prev-tbl').innerHTML=html;
  document.getElementById('prev-sec').style.display='block';
  document.getElementById('gen-sec').style.display='block';
  renderFileList();
}

function renderFileList(){
  var fl=document.getElementById('file-list');
  var allFiles=uploadedFiles.slice();
  // Also show pending (not yet saved) file
  if(pendingData&&!uploadedFiles.some(function(f){return f.name===pendingData.name;})){
    allFiles.unshift({name:pendingData.name,size:pendingData.size||0,ext:pendingData.ext||'xlsx',sheetNames:pendingData.sheetNames,pending:true});
  }
  if(!allFiles.length){fl.innerHTML='';return;}
  var frag=document.createDocumentFragment();
  allFiles.forEach(function(f,i){
    var item=document.createElement('div'); item.className='file-item';
    var extClass=f.ext==='csv'?'csv':'xlsx';
    item.innerHTML='<div class="ficon '+extClass+'">'+f.ext.toUpperCase()+'</div>'+
      '<div class="fmeta"><div class="fname">'+escH(f.name)+'</div>'+
      '<div class="fsize">'+fmtFS(f.size)+(f.sheetNames?' · '+f.sheetNames.length+' sheet(s)':'')+'</div></div>'+
      '<span class="fstatus">'+(f.pending?'Ready':'Saved')+'</span>';
    if(!f.pending){
      var db=document.createElement('button'); db.className='del-btn';
      db.title='Remove file';
      db.innerHTML='<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
      db.onclick=(function(idx){return function(){deleteFile(idx);};})(i);
      item.appendChild(db);
    }
    frag.appendChild(item);
  });
  fl.innerHTML=''; fl.appendChild(frag);
}

function deleteFile(idx){
  if(!confirm('Remove "'+uploadedFiles[idx].name+'" from your document list?'))return;
  uploadedFiles.splice(idx,1);
  renderFileList();
  showToast('File removed.');
}

