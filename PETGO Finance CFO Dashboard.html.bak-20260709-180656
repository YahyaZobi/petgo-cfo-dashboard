function exportFnTable(tableId,sheetName){
  var tbl=document.getElementById(tableId);
  if(!tbl){showToast('Table not found.');return;}
  try{
    var wb=XLSX.utils.book_new();
    // Strip action-column cells (last td with buttons)
    var rows=[];
    tbl.querySelectorAll('tr').forEach(function(tr){
      var row=[];
      var cells=tr.querySelectorAll('th,td');
      cells.forEach(function(td,ci){
        if(ci===cells.length-1&&td.querySelector('button'))return;// skip actions column
        row.push(td.textContent.trim());
      });
      if(row.length)rows.push(row);
    });
    var ws=XLSX.utils.aoa_to_sheet(rows);
    XLSX.utils.book_append_sheet(wb,ws,sheetName||'Data');
    XLSX.writeFile(wb,'PETGO_'+sheetName+'_'+today()+'.xlsx');
    showToast(sheetName+' exported to Excel.');
    addAudit('Export','Exported table: '+sheetName,'#10b981');
  }catch(e){showToast('Export failed: '+e.message);}
}
function exportAuditLog(){
  var log=fnLoad('petgo_audit_log',[]);
  try{
    var wb=XLSX.utils.book_new();
    var rows=[['Time','Module','Action']];
    log.forEach(function(e){rows.push([e.time,e.module,e.action]);});
    var ws=XLSX.utils.aoa_to_sheet(rows);
    XLSX.utils.book_append_sheet(wb,ws,'Audit Log');
    XLSX.writeFile(wb,'PETGO_AuditLog_'+today()+'.xlsx');
    showToast('Audit log exported.');
  }catch(e){showToast('Export failed.');}
}
function printPanel(panelId){
  // Hide all panels, show only the target, print, restore
  var panels=document.querySelectorAll('.cp');
  var states=[];
  panels.forEach(function(p){states.push(p.className);p.className=p.className.replace(/\bactive\b/,'').trim();});
  var target=document.getElementById(panelId);
  if(target)target.classList.add('active');
  window.print();
  // Restore
  panels.forEach(function(p,i){p.className=states[i];});
}

