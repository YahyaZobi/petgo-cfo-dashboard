  document.getElementById('inv-f-desc').value=i.desc||'';
  document.getElementById('inv-f-amount').value=i.amount||'';
  document.getElementById('inv-f-issue').value=i.issue||today();
  document.getElementById('inv-f-due').value=i.due||'';
  document.getElementById('inv-f-status').value=i.status||'Pending';
