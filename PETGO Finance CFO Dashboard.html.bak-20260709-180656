function toggleAllNotifs(on){
  notifPrefs.all=on;
  document.querySelectorAll('.notif-child').forEach(function(cb){cb.checked=on;});
  Object.keys(notifPrefs).forEach(function(k){if(k!=='all')notifPrefs[k]=on;});
  if(on) requestBrowserNotifPermission();
  else showToast('All notifications disabled.');
}

function requestBrowserNotifPermission(){
  if(!('Notification' in window)){showToast('Browser notifications not supported.');return;}
  if(Notification.permission==='granted'){
    updatePermBadge('granted'); return;
  }
  if(Notification.permission==='denied'){
    updatePermBadge('denied'); return;
  }
  Notification.requestPermission().then(function(p){updatePermBadge(p);});
}

function updatePermBadge(perm){
  var badge=document.getElementById('notif-perm-badge');
  var banner=document.getElementById('notif-perm-banner');
  if(perm==='granted'){
    if(badge){badge.style.background='#dcfce7';badge.style.color='#15803d';badge.textContent='Browser alerts ON';badge.style.display='inline-block';}
    if(banner)banner.style.display='none';
    showToast('Browser notifications enabled ✓');
  }else if(perm==='denied'){
    if(badge){badge.style.background='#fee2e2';badge.style.color='#991b1b';badge.textContent='Browser access blocked';badge.style.display='inline-block';}
    if(banner)banner.style.display='none';
    showToast('Notifications blocked. Enable in browser settings.');
  }else{
    if(banner)banner.style.display='block';
    if(badge)badge.style.display='none';
  }
}

function sendDesktopNotif(title,body,tag){
  if(!('Notification' in window)||Notification.permission!=='granted') return;
  try{
    new Notification(title,{body:body,tag:tag||title,silent:false});
  }catch(e){}
}

function fireNotif(type){
  if(!notifPrefs.all||!notifPrefs[type]){
    showToast('Enable the "'+type+'" notification type first.');return;
  }
  var def=NOTIF_DEFS[type];
  if(!def)return;
  // In-app notification panel
  addInAppNotif(def.title,def.body,type==='ar'?'#ef4444':type==='cf'?'#f59e0b':'#10b981');
  // Desktop notification
  if(Notification.permission==='granted'){
    sendDesktopNotif(def.title,def.body,type);
  }else{
    requestBrowserNotifPermission();
  }
  // Email if urgent or email-all on
  if(emailPrefs.all&&emailPrefs.urgent&&(type==='ar'||type==='budget')){
    setTimeout(function(){sendEmailAlert('urgent');},500);
  }
  showToast('Notification sent: '+def.title);
}

function addInAppNotif(title,body,dotColor){
