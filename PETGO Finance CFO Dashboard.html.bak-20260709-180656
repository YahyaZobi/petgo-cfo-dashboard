      '<td><span class="fn-badge '+bc+'">'+escH(inv.status)+'</span></td>'+
      '<td><div class="fn-row-actions"><button class="fn-btn-edit" onclick="openInvModal('+idx+')">Edit</button><button class="fn-btn-del" onclick="delInv('+idx+')"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg></button></div></td></tr>';
  }).join('');
