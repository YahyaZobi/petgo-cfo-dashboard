  {id:5,type:'out',cat:'Refreshments',desc:'Client meeting refreshments',amount:210,date:'2026-06-12'},
  {id:6,type:'out',cat:'Transport',desc:'Airport pickup',amount:150,date:'2026-06-15'}
]);
var pettyEditIdx=-1; var pettyFilter='All';
function savePettyStore(){fnSave('petgo_petty',pettyCash);}
function renderPetty(){
  var totalIn=pettyCash.filter(function(p){return p.type==='in';}).reduce(function(s,p){return s+p.amount;},0);
  var totalOut=pettyCash.filter(function(p){return p.type==='out';}).reduce(function(s,p){return s+p.amount;},0);
  var bal=totalIn-totalOut;
  document.getElementById('petty-kpis').innerHTML=
    fnKpi('Current Balance',fmtMoney(bal),'Cash in hand','#dcfce7','#15803d','$')+
    fnKpi('Total In',fmtMoney(totalIn),'Cash received','#dbeafe','#1d4ed8','↑')+
    fnKpi('Total Out',fmtMoney(totalOut),'Cash disbursed','#fee2e2','#991b1b','↓')+
    fnKpi('Transactions',pettyCash.length+' entries','All entries','#f3e8ff','#6b21a8','#');
  filterPetty(pettyFilter);
}
function filterPetty(f,el){
  pettyFilter=f;
  if(el){document.querySelectorAll('#panel-fin-petty .fn-filter').forEach(function(x){x.classList.remove('active');});el.classList.add('active');}
  var list=f==='All'?pettyCash:pettyCash.filter(function(p){return p.type===f;});
  var tb=document.getElementById('petty-tbody'); if(!tb)return;
  if(!list.length){tb.innerHTML='<tr><td colspan="7" class="fn-empty">No transactions found.</td></tr>';return;}
  // Running balance
  var runBal=0;
  var sorted=[...pettyCash].sort(function(a,b){return a.date>b.date?1:-1;});
  var balMap={};sorted.forEach(function(p){runBal+=p.type==='in'?p.amount:-p.amount;balMap[p.id]=runBal;});
  tb.innerHTML=list.map(function(p){
    var idx=pettyCash.indexOf(p);
    return '<tr><td>'+fmtDate(p.date)+'</td><td><span class="'+(p.type==='in'?'fn-in':'fn-out')+'">'+(p.type==='in'?'▲ Cash In':'▼ Cash Out')+'</span></td><td>'+escH(p.cat)+'</td><td>'+escH(p.desc)+'</td>'+
      '<td class="'+(p.type==='in'?'tg':'tr')+'">'+(p.type==='in'?'+':'-')+fmtMoney(p.amount)+'</td>'+
      '<td>'+fmtMoney(balMap[p.id])+'</td>'+
      '<td><div class="fn-row-actions"><button class="fn-btn-edit" onclick="openPettyModal('+idx+')">Edit</button><button class="fn-btn-del" onclick="delPetty('+idx+')"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg></button></div></td></tr>';
  }).join('');
}
function openPettyModal(idx){
  pettyEditIdx=(idx===undefined)?-1:idx;
  var p=pettyEditIdx>=0?pettyCash[pettyEditIdx]:{type:'out',cat:'',desc:'',amount:'',date:today()};
  document.getElementById('petty-f-type').value=p.type||'out';
  document.getElementById('petty-f-cat').value=p.cat||'';
  document.getElementById('petty-f-desc').value=p.desc||'';
  document.getElementById('petty-f-amount').value=p.amount||'';
  document.getElementById('petty-f-date').value=p.date||today();
  openFnModal('petty-modal',pettyEditIdx>=0?'Edit Entry':'Add Entry','petty-modal-ttl');
}
function savePetty(){
  var amount=parseFloat(document.getElementById('petty-f-amount').value)||0;
  var date=document.getElementById('petty-f-date').value;
  if(!amount||!date){showToast('Amount and date are required.');return;}
  var p={id:pettyEditIdx>=0?pettyCash[pettyEditIdx].id:fnId(),type:document.getElementById('petty-f-type').value,cat:document.getElementById('petty-f-cat').value.trim(),desc:document.getElementById('petty-f-desc').value.trim(),amount:amount,date:date};
  if(pettyEditIdx>=0){pettyCash[pettyEditIdx]=p;showToast('Entry updated.');}else{pettyCash.push(p);showToast('Entry added.');}
  savePettyStore();closeFnModal('petty-modal');renderPetty();
