var _serverAvailable=false;
var _serverUrl='http://localhost:8000';
var _serverStatus={};// module -> {last, count}

async function _probeServer(){
  try{
    var r=await fetch(_serverUrl+'/api/status',{signal:AbortSignal.timeout(1500)});
    if(r.ok){_serverAvailable=true;_updateAPIBadge(GRAPH_MODE&&!!_graphToken);return true;}
  }catch(e){}
  _serverAvailable=false;
  _updateAPIBadge(GRAPH_MODE&&!!_graphToken);
  return false;
}

async function _fetchFromServer(module){
  try{
    var r=await fetch(_serverUrl+'/api/'+module,{signal:AbortSignal.timeout(8000)});
    if(!r.ok)return false;
    var j=await r.json();
    if(j.data&&j.data.length){
      _applyAPIData(module,j.data);
      _serverStatus[module]={last:j.last_refresh,count:j.record_count};
      return true;
    }
  }catch(e){console.warn('Server fetch failed for '+module+':',e);}
  return false;
}

// Push data into live JS arrays + localStorage cache
function _applyAPIData(module,data){
  if(!data||!data.length)return;
  var lsKey=API_KEY_MAP[module];
  if(lsKey)_origFnSave(lsKey,data);
  if(module==='employees')employees=data;
  else if(module==='invoices')invoices=data;
  else if(module==='budgets')budgets=data;
  else if(module==='expenses')expenses=data;
  else if(module==='petty')pettyTx=data;
  else if(module==='projects')projects=data;
  else if(module==='leaves')leaves=data;
  else if(module==='payroll')payroll=data;
  else if(module==='contracts')contracts=data;
  else if(module==='onboarding')onboarding=data;
}

// Download an Excel file from OneDrive personal path or SharePoint URL
async function _graphDownloadExcel(filePath){
  var token=_graphToken||await _msalGetToken();
  if(!token) throw new Error('Not signed in to Microsoft');
  var url;
  if(filePath.startsWith('https://')){
    // SharePoint URL or OneDrive share link → use /shares API
    var encoded='u!'+btoa(filePath).replace(/=/g,'').replace(/\+/g,'-').replace(/\//g,'_');
    url='https://graph.microsoft.com/v1.0/shares/'+encoded+'/driveItem/content';
  } else {
    // OneDrive personal path  e.g. /Documents/Finance/data.xlsx
    var path=filePath.startsWith('/')?filePath:'/'+filePath;
    url='https://graph.microsoft.com/v1.0/me/drive/root:'+path+':/content';
  }
  var resp=await fetch(url,{headers:{'Authorization':'Bearer '+token},signal:AbortSignal.timeout(25000)});
  if(!resp.ok){
    var errBody=await resp.json().catch(function(){return {error:{message:'HTTP '+resp.status}};});
    throw new Error((errBody.error&&errBody.error.message)||'HTTP '+resp.status);
  }
  return await resp.arrayBuffer();
}

// Fetch one module — server first, Graph fallback
async function fetchModule(module){
  if(_serverAvailable){
    var ok=await _fetchFromServer(module);
    if(ok)return true;
  }
  if(!GRAPH_MODE||!_graphToken) return false;
  var src=(_dsConfig&&_dsConfig.sources&&_dsConfig.sources[module])||{};
  if(!src.enabled||!src.path) return false;
  try {
    var buffer=await _graphDownloadExcel(src.path);
    var wb=XLSX.read(buffer,{type:'array'});
    var sheetName=src.sheet||wb.SheetNames[0];
    var ws=wb.Sheets[sheetName]||wb.Sheets[wb.SheetNames[0]];
    if(!ws) throw new Error('Sheet "'+sheetName+'" not found');
    var data=XLSX.utils.sheet_to_json(ws,{defval:''});
    if(data&&data.length){
      _applyAPIData(module,data);
      GRAPH_SOURCE_STATUS[module]={status:'ok',count:data.length,last:new Date().toISOString()};
      return true;
    }
  } catch(e){
    GRAPH_SOURCE_STATUS[module]={status:'error',error:e.message};
    console.warn('Graph fetch failed for '+module+':',e);
  }
  return false;
}

// Sync all enabled modules at once
async function _graphRefreshAll(){
  if(!_graphToken){showToast('Sign in with Microsoft first.');return;}
  var mods=DS_MODULES.filter(function(m){
    var s=(_dsConfig.sources||{})[m]; return s&&s.enabled&&s.path;
  });
  if(!mods.length){showToast('No sources configured. Enter OneDrive paths first.');return;}
  showToast('Syncing '+mods.length+' sources from OneDrive…');
  var ok=0;
  for(var i=0;i<mods.length;i++){if(await fetchModule(mods[i]))ok++;}
  showToast('Sync complete: '+ok+'/'+mods.length+' sources updated.');
  renderDSPanel();
}

