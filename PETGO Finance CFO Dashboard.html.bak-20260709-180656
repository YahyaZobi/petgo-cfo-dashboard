function generatePayslip(idx){
  var p=payroll[idx]; if(!p) return;
  var allStaff=(typeof STAFF_DIR!=='undefined'?STAFF_DIR:[]).concat(employees||[]);
  var emp=allStaff.find(function(e){return e.name===p.name;})||{};
  var empId=p.empId||emp.empId||(function(){
    var all=(typeof STAFF_DIR!=='undefined'?STAFF_DIR:[]).concat(employees||[]);
    var m=all.find(function(e){return e.name===p.name;});
    return m?m.empId:'—';
  })();
  var slipNo='PS-'+new Date().getFullYear()+'-'+String(p.id||idx+1).padStart(4,'0');
  document.getElementById('ps-doc').innerHTML=buildPayslipHTML(p,emp.title||'',empId,slipNo,_psIssueDate());
  document.getElementById('ps-overlay').classList.add('open');
}

function closePayslipModal(evt,force){
  if(force||(evt&&evt.target===document.getElementById('ps-overlay'))){
    document.getElementById('ps-overlay').classList.remove('open');
  }
}

function _psOpenWindow(bodyHTML, title){
  var styles=Array.from(document.styleSheets).map(function(ss){
    try{return Array.from(ss.cssRules).map(function(r){return r.cssText;}).join('\n');}catch(e){return '';}
  }).join('\n');
  var win=window.open('','_blank','width=800,height=1050');
  win.document.write('<!DOCTYPE html><html><head><meta charset="UTF-8"><title>'+title+'</title><style>'+
    'body{margin:0;padding:28px;background:#f1f5f9;display:flex;flex-direction:column;align-items:center;gap:28px;}'+
    '.ps-doc{max-width:660px;width:100%;font-family:Arial,Helvetica,sans-serif;box-shadow:0 4px 24px rgba(0,0,0,0.12);border-radius:4px;overflow:hidden;}'+
    styles+
    '@media print{body{background:#fff!important;padding:0!important;gap:0!important;}.ps-doc{box-shadow:none!important;border-radius:0!important;}@page{margin:10mm;size:A4;}}'+
    '</style></head><body>'+bodyHTML+'</body></html>');
  win.document.close(); win.focus();
  setTimeout(function(){win.print();},700);
}

function printPayslip(){
  var html=document.getElementById('ps-doc').innerHTML;
  _psOpenWindow('<div class="ps-doc">'+html+'</div>','PETGO Payslip');
}

function exportAllPayslips(){
  var sel=document.getElementById('pay-month-sel');
  var month=sel?sel.value:'';
  var list=payroll.filter(function(p){return !month||p.month===month;});
  if(!list.length){showToast('No payroll entries for this period.');return;}
  var allStaff=(typeof STAFF_DIR!=='undefined'?STAFF_DIR:[]).concat(employees||[]);
  var issueDate=_psIssueDate();
  var allHTML=list.map(function(p,i){
    var idx=payroll.indexOf(p);
    var emp=allStaff.find(function(e){return e.name===p.name;})||{};
    return '<div class="ps-doc" style="page-break-after:'+(i<list.length-1?'always':'avoid')+'">'+
      buildPayslipHTML(p,emp.title||'',_psId(p,idx),_psRef(p,idx),issueDate)+'</div>';
  }).join('');
  _psOpenWindow(allHTML,'PETGO Payslips — '+month);
}

