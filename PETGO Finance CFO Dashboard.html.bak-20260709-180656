// ── SMART NOTIFICATIONS (wired to live data) ─────────
// ═══════════════════════════════════════════════════════
function checkSmartNotifications(){
  var alerts=[];
  var todayStr=today();
  // Overdue invoices
  (invoices||[]).forEach(function(inv){
    if(inv.status!=='Paid'&&inv.due&&inv.due<todayStr){
      var d=daysBetween(inv.due,todayStr);
      alerts.push({type:'error',title:'Overdue Invoice',body:inv.vendor+' — '+fmtMoney(inv.amount)+' overdue by '+d+' days',panel:'fin-invoices'});
    }
  });
  // Expiring contracts (within 60 days)
  (contracts||[]).forEach(function(c){
    if(c.end){
      var d=daysBetween(todayStr,c.end);
      if(d>=0&&d<=60){
        alerts.push({type:d<=14?'error':'warn',title:'Contract Expiring',body:c.name+' — '+c.type+' ends in '+d+' days',panel:'hr-contracts'});
      }
    }
  });
  // Pending expense claims
  var pendingExp=(expenses||[]).filter(function(x){return x.status==='Pending';});
  if(pendingExp.length>0){
    alerts.push({type:'warn',title:'Pending Expense Claims',body:pendingExp.length+' claim(s) awaiting approval',panel:'fin-expenses'});
  }
  // Pending leave requests
  var pendingLeave=(leaves||[]).filter(function(l){return l.status==='Pending';});
  if(pendingLeave.length>0){
    alerts.push({type:'info',title:'Pending Leave Requests',body:pendingLeave.length+' leave request(s) awaiting approval',panel:'hr-leave'});
  }
  // Budget overspend
  (budgets||[]).forEach(function(b){
    if(b.budgeted>0&&b.spent>b.budgeted){
      alerts.push({type:'error',title:'Budget Exceeded',body:b.dept+' / '+b.cat+' overspent by '+fmtMoney(b.spent-b.budgeted),panel:'fin-budget'});
    }
  });
  // Inject into notification center
  if(alerts.length){
    var existing=notifications||[];
    // Only add new ones not already in list (by title+body combo)
    var existingKeys=existing.map(function(n){return n.title+n.body;});
    var newAlerts=alerts.filter(function(a){return existingKeys.indexOf(a.title+a.body)===-1;});
    newAlerts.forEach(function(a){
      existing.unshift({id:fnId(),type:a.type,title:a.title,body:a.body,time:'Just now',read:false,panel:a.panel});
    });
    if(newAlerts.length){
      notifications=existing;
      saveNotifs();
      updateNotifBadge();
    }
  }
}

