  showToast(isAr?'تم تغيير اللغة إلى العربية':'Language set to English');
}

// ── CURRENCIES ─────────────────────────────────────
var currentCurrency={symbol:'$',rate:1,code:'USD'};
var CURRENCIES={
  'USD ($)':{symbol:'$',rate:1,code:'USD'},
  'EUR (€)':{symbol:'€',rate:0.92,code:'EUR'},
  'LYD (LD)':{symbol:'LD ',rate:4.85,code:'LYD'}
};
function applyCurrency(key){
  currentCurrency=CURRENCIES[key]||{symbol:'$',rate:1,code:'USD'};
  showToast('Currency set to '+currentCurrency.code+'. Regenerate reports to apply.');
}
function fmtMoney(v){
  var val=v*currentCurrency.rate, s=currentCurrency.symbol;
  if(Math.abs(val)>=1e6)return s+(val/1e6).toFixed(2)+'M';
  if(Math.abs(val)>=1e3)return s+(val/1e3).toFixed(1)+'K';
  return s+val.toFixed(2);
}

// ── MSAL / MICROSOFT GRAPH CONFIG ─────────────────────
var GRAPH_CLIENT_ID = localStorage.getItem('petgo_client_id') || '';
var GRAPH_TENANT_ID = localStorage.getItem('petgo_tenant_id') || '';
var _msalInstance = null;
var _graphToken = null;

function _initMSAL(){
  if(!GRAPH_CLIENT_ID||!GRAPH_TENANT_ID||typeof msal==='undefined') return false;
  try {
    _msalInstance = new msal.PublicClientApplication({
      auth:{
        clientId: GRAPH_CLIENT_ID,
        authority: 'https://login.microsoftonline.com/'+GRAPH_TENANT_ID,
        redirectUri: 'https://petgo-dashboard.netlify.app'
      },
      cache:{cacheLocation:'localStorage',storeAuthStateInCookie:false}
    });
    // Check if already signed in from previous session
    var accounts = _msalInstance.getAllAccounts();
    if(accounts.length){
      _msalInstance.acquireTokenSilent({
        scopes:['User.Read','Files.Read','Files.Read.All','Sites.Read.All'],
        account:accounts[0]
      }).then(function(r){ _graphToken=r.accessToken; }).catch(function(){});
    }
    return true;
  } catch(e){ console.warn('MSAL init failed:',e); return false; }
}

async function _msalGetToken(){
  if(!_msalInstance) return null;
  var accounts = _msalInstance.getAllAccounts();
  if(!accounts.length) return null;
  try {
    var r = await _msalInstance.acquireTokenSilent({
      scopes:['User.Read','Files.Read','Files.Read.All','Sites.Read.All'],
      account:accounts[0]
    });
    _graphToken = r.accessToken;
    return r.accessToken;
  } catch(e) {
    try {
      var r2 = await _msalInstance.acquireTokenPopup({
        scopes:['User.Read','Files.Read','Files.Read.All','Sites.Read.All']
      });
      _graphToken = r2.accessToken;
      return r2.accessToken;
    } catch(e2){ return null; }
  }
}

// ── LOGIN ──────────────────────────────────────────
var USERS = {
  'karen.mombay@petgo.ly': {name:'Karen Mombay',initials:'KM'},
  'yahya.zoubi@petgo.ly':  {name:'Yahya Zoubi',empId:'PTG-002', initials:'YZ'}
};
function _isAllowed(email){
  return email.endsWith('@petgo.ly');
}
function _userFromEmail(email){
  if(USERS[email])return USERS[email];
  // Derive name from email prefix: first.last@petgo.ly → First Last
  var parts=email.split('@')[0].split('.');
  var name=parts.map(function(p){return p.charAt(0).toUpperCase()+p.slice(1);}).join(' ');
  var initials=parts.map(function(p){return p.charAt(0).toUpperCase();}).join('').slice(0,2);
  return {name:name,initials:initials};
}
var currentUser = null;
var loggedIn = false;

function login(email,password,remember){
  email=(email||'').trim().toLowerCase();
  var box=document.getElementById('vantage-login-error');
  var txt=document.getElementById('vantage-login-error-text');
  function fail(msg){txt.textContent=msg;box.classList.add('is-visible');}
  if(!_isAllowed(email)){fail("That account doesn't have access. Only @petgo.ly work emails are allowed.");return;}
  if(password.length<4){fail('Your password is incorrect. Try again.');return;}
  box.classList.remove('is-visible');txt.textContent='';
  if(remember){localStorage.setItem('petgo_login_email',email);}else{localStorage.removeItem('petgo_login_email');}
  currentUser=email;
  bootApp();
}
window.login=login;
function bootApp(){
  document.getElementById('ms-overlay').style.display='none';
  document.getElementById('app').style.display='flex';
  loggedIn=true;
  var u=_userFromEmail(currentUser);
  document.getElementById('u-name').textContent=u.name;
  document.getElementById('u-email').textContent=currentUser;
  document.getElementById('u-init').textContent=u.initials;
  // Sync Settings account panel
  var an=document.getElementById('settings-acc-name'); if(an)an.textContent=u.name;
  var ae=document.getElementById('settings-acc-email'); if(ae)ae.textContent=currentUser;
  var av=document.getElementById('settings-acc-av'); if(av)av.textContent=u.initials;
  // Load employee data first so stored photos are available
  loadEmployees();
  // Load profile photo (checks employee record first)
  loadProfilePhoto(currentUser, u.name);
  setTimeout(renderCFOCharts,60);
  // Fire AR alert notification on login if enabled
  setTimeout(function(){
    if(notifPrefs.all&&notifPrefs.ar&&Notification&&Notification.permission==='granted'){
      sendDesktopNotif(NOTIF_DEFS.ar.title,NOTIF_DEFS.ar.body,'ar-login');
    }
  },2000);
  showToast('Welcome back, '+u.name.split(' ')[0]+'!');
}

function loadProfilePhoto(email, name){
  var imgs=['u-img','settings-u-img'];
  var inits=['u-init','settings-acc-av-txt'];

  function setImg(src){
    imgs.forEach(function(id){
      var el=document.getElementById(id); if(!el)return;
      el.src=src; el.style.display='block';
      el.onerror=function(){
        this.style.display='none';
        var idx=imgs.indexOf(id);
        var ie=document.getElementById(inits[idx]); if(ie)ie.style.display='';
      };
    });
    inits.forEach(function(id){var el=document.getElementById(id);if(el)el.style.display='none';});
  }

  function setFallback(){
    setImg('https://ui-avatars.com/api/?name='+encodeURIComponent(name)+'&background=1e3a5f&color=fff&size=128&bold=true&format=png');
  }

  // 1st: stored photo in Team directory
  var emailLower=(email||'').toLowerCase();
  var empMatch=(employees||[]).find(function(e){return (e.email||'').toLowerCase()===emailLower;});
  if(empMatch&&empMatch.photo){setImg(empMatch.photo);return;}

  // 2nd: Microsoft Graph with real token (most reliable)
  if(_graphToken){
    fetch('https://graph.microsoft.com/v1.0/me/photo/$value',{
      headers:{'Authorization':'Bearer '+_graphToken}
    }).then(function(r){
      if(!r.ok) throw new Error('no photo');
      return r.blob();
    }).then(function(blob){ setImg(URL.createObjectURL(blob)); })
    .catch(setFallback);
    return;
  }

  // 3rd: OWA endpoint (works if browser has active O365 session)
  var owaUrl='https://outlook.office.com/owa/service.svc/s/GetPersonaPhoto?email='+encodeURIComponent(email)+'&size=HR64x64&UA=0';
  var probe=new Image(); probe.crossOrigin='anonymous';
  probe.onload=function(){setImg(owaUrl);};
  probe.onerror=setFallback;
  probe.src=owaUrl;
}

// Call this after saving an employee to refresh header photo if it's the current user
function refreshCurrentUserPhoto(){
  if(!loggedIn||!currentUser)return;
  var u=USERS[currentUser]||{name:'User'};
  loadProfilePhoto(currentUser,u.name);
}
async function doLogout(){
  if(!confirm('Sign out of PETGO Finance?'))return;
  // Sign out of MSAL if we used real Microsoft login
  if(_msalInstance&&_graphToken){
    _graphToken=null;
    try{ await _msalInstance.logoutPopup(); }catch(e){}
  }
  _graphToken=null;
  loggedIn=false;
  document.getElementById('app').style.display='none';
  document.getElementById('ms-overlay').style.display='flex';
  document.getElementById('vantage-login-password').value='';
  document.getElementById('vantage-login-email').value=localStorage.getItem('petgo_login_email')||'';
  document.getElementById('vantage-login-error').classList.remove('is-visible');
  document.getElementById('vantage-login-error-text').textContent='';
  currentUser=null; uploadedFiles=[]; pendingData=null;
  document.getElementById('file-list').innerHTML='';
  document.getElementById('prev-sec').style.display='none';
  document.getElementById('gen-sec').style.display='none';
  // Reset report tabs
  var rtbar=document.getElementById('rtbar');
  Array.from(rtbar.querySelectorAll('.rtab')).forEach(function(b){if(b.textContent!=='CFO Overview')b.remove();});
  var panels=document.getElementById('rpt-panels');
  Array.from(panels.querySelectorAll('.rp.gen-report')).forEach(function(p){p.remove();});
  panelInited={};
  Object.keys(CIs).forEach(function(k){try{CIs[k].destroy();}catch(e){}});
  CIs={};
}

// ── NAVIGATION ─────────────────────────────────────
var panelInited={};
var CIs={};

function navTo(id,el){
  document.querySelectorAll('.cp').forEach(function(p){p.classList.remove('active');});
  document.querySelectorAll('.sb-nav li').forEach(function(li){li.classList.remove('active');});
  var p=document.getElementById('panel-'+id);
  if(p)p.classList.add('active');
  if(el)el.classList.add('active');
  if(!panelInited[id]){
    panelInited[id]=true;
    setTimeout(function(){
      if(id==='exec'){renderCFOCharts();renderHistoryTimeline();}
      if(id==='analytics')renderAnalyticsCharts();
      if(id==='settings')checkNotifPermOnSettingsOpen();
      if(id==='team')renderEmpGrid();
    },40);
  }
  document.getElementById('notif-panel').classList.remove('open');
}

function showRTab(id,btn){
  document.querySelectorAll('.rp').forEach(function(p){p.classList.remove('active');});
  document.querySelectorAll('.rtab').forEach(function(b){b.classList.remove('active');});
  var r=document.getElementById(id); if(r)r.classList.add('active');
  if(btn)btn.classList.add('active');
}

// ── NOTIFICATIONS ───────────────────────────────────
var unread=4;
updateBadge();
function updateBadge(){document.getElementById('notif-badge').style.display=unread>0?'block':'none';}
function toggleNotif(e){
  e.stopPropagation();
  document.getElementById('notif-panel').classList.toggle('open');
}
document.addEventListener('click',function(e){
  var p=document.getElementById('notif-panel'),b=document.getElementById('bell-btn');
  if(!p.contains(e.target)&&!b.contains(e.target))p.classList.remove('open');
});
function markRead(item){
  if(!item.classList.contains('read')){item.classList.add('read');unread=Math.max(0,unread-1);updateBadge();}
}
function markAllRead(){
  document.querySelectorAll('.npi').forEach(function(i){i.classList.add('read');});
  unread=0;updateBadge();showToast('All notifications marked as read.');
}
