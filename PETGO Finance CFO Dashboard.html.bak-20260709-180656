var calYear=new Date().getFullYear(),calMonth=new Date().getMonth();
function renderLeaveCalendar(){
  var wrap=document.getElementById('leave-cal');if(!wrap)return;
  var daysInMonth=new Date(calYear,calMonth+1,0).getDate();
  var firstDay=new Date(calYear,calMonth,1).getDay(); // 0=Sun
  var todayD=new Date();
  // Build a map: day → [{name,status}]
  var dayMap={};
  (leaves||[]).filter(function(l){return l.status!=='Rejected';}).forEach(function(l){
    if(!l.start||!l.end)return;
    var s=new Date(l.start),e=new Date(l.end);
    for(var d=new Date(s);d<=e;d.setDate(d.getDate()+1)){
      if(d.getFullYear()===calYear&&d.getMonth()===calMonth){
        var day=d.getDate();
        if(!dayMap[day])dayMap[day]=[];
        dayMap[day].push({name:l.emp,status:l.status});
      }
    }
  });
  var monthNames=['January','February','March','April','May','June','July','August','September','October','November','December'];
  var html='<div class="lcal-nav">'+
    '<button class="lcal-nav-btn" onclick="calMonth--;if(calMonth<0){calMonth=11;calYear--;}renderLeaveCalendar()">‹</button>'+
    '<div class="lcal-month">'+monthNames[calMonth]+' '+calYear+'</div>'+
    '<button class="lcal-nav-btn" onclick="calMonth++;if(calMonth>11){calMonth=0;calYear++;}renderLeaveCalendar()">›</button>'+
  '</div>'+
  '<div class="lcal-grid">'+
    ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(function(d){return '<div class="lcal-day-hdr">'+d+'</div>';}).join('');
  // Empty cells for offset
  for(var i=0;i<firstDay;i++)html+='<div class="lcal-day"></div>';
  for(var d=1;d<=daysInMonth;d++){
    var isToday=d===todayD.getDate()&&calMonth===todayD.getMonth()&&calYear===todayD.getFullYear();
    var entries=dayMap[d]||[];
    var hasPend=entries.some(function(x){return x.status==='Pending';});
    var hasApprv=entries.some(function(x){return x.status==='Approved';});
    var cls='lcal-day'+(isToday?' today':'')+(hasPend?' has-pending':'')+(hasApprv&&!hasPend?' has-leave':'');
    var dots=entries.slice(0,3).map(function(x){return '<div class="lcal-dot" style="background:'+(x.status==='Approved'?'#10b981':'#f59e0b')+'" title="'+escH(x.name)+'"></div>';}).join('');
    html+='<div class="'+cls+'"><div class="lcal-day-num">'+d+'</div><div class="lcal-dots">'+dots+'</div></div>';
  }
  html+='</div>';
  wrap.innerHTML=html;
}

