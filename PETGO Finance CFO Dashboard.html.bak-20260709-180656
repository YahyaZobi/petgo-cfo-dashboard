function _psNumToWords(n){
  var ones=['','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve','Thirteen','Fourteen','Fifteen','Sixteen','Seventeen','Eighteen','Nineteen'];
  var tens=['','','Twenty','Thirty','Forty','Fifty','Sixty','Seventy','Eighty','Ninety'];
  if(n===0) return 'Zero';
  var w=''; n=Math.round(Math.abs(n));
  if(Math.floor(n/1000000)>0){w+=_psNumToWords(Math.floor(n/1000000))+' Million '; n=n%1000000;}
  if(Math.floor(n/1000)>0){w+=_psNumToWords(Math.floor(n/1000))+' Thousand '; n=n%1000;}
  if(Math.floor(n/100)>0){w+=ones[Math.floor(n/100)]+' Hundred '; n=n%100;}
  if(n>0){w+=(n<20?ones[n]:tens[Math.floor(n/10)]+(n%10?' '+ones[n%10]:''));}
  return w.trim();
}
function _psMoney(v){return fmtMoney(v);}
function _psId(p,idx){return 'EMP-'+String(p.id||idx+1).padStart(4,'0');}
function _psRef(p,idx){return 'PS-'+new Date().getFullYear()+'-'+String(p.id||idx+1).padStart(4,'0');}
function _psIssueDate(){return new Date().toLocaleDateString('en-GB',{day:'2-digit',month:'long',year:'numeric'});}

