function openGSearch(){
  document.getElementById('gsearch-overlay').classList.add('open');
  setTimeout(function(){document.getElementById('gsearch-inp').focus();},80);
}
function closeGSearch(){document.getElementById('gsearch-overlay').classList.remove('open');document.getElementById('gsearch-inp').value='';document.getElementById('gsearch-results').innerHTML='<div class="gsearch-empty">Type to search across all modules…</div>';}
document.addEventListener('keydown',function(e){if((e.ctrlKey||e.metaKey)&&e.key==='k'){e.preventDefault();openGSearch();}if(e.key==='Escape')closeGSearch();});
function gSearchKey(e){if(e.key==='Escape')closeGSearch();}
function runGSearch(q){
  var r=document.getElementById('gsearch-results');
  q=q.trim().toLowerCase();
  if(!q){r.innerHTML='<div class="gsearch-empty">Type to search across all modules…</div>';return;}
  var results=[];
  // Employees
  (employees||[]).forEach(function(e){
    if(e.name&&e.name.toLowerCase().includes(q)||e.title&&e.title.toLowerCase().includes(q)||e.dept&&e.dept.toLowerCase().includes(q)){
      results.push({icon:'👤',iconBg:'#e0f2fe',label:e.name,sub:(e.title||'')+(e.dept?' · '+e.dept:''),panel:'team',cat:'Employees'});
    }
  });
  // Invoices
  (invoices||[]).forEach(function(i){
    if(i.vendor&&i.vendor.toLowerCase().includes(q)||i.desc&&i.desc.toLowerCase().includes(q)){
      results.push({icon:'🧾',iconBg:'#f0fdf4',label:i.vendor,sub:i.desc+' · '+fmtMoney(i.amount),panel:'fin-invoices',cat:'Invoices'});
    }
  });
  // Projects
  (projects||[]).forEach(function(p){
    if(p.name&&p.name.toLowerCase().includes(q)){
      results.push({icon:'📋',iconBg:'#fdf4ff',label:p.name,sub:'Budget: '+fmtMoney(p.budget)+' · '+p.status,panel:'fin-projects',cat:'Projects'});
    }
  });
  // Budgets
  (budgets||[]).forEach(function(b){
    if(b.dept&&b.dept.toLowerCase().includes(q)||b.cat&&b.cat.toLowerCase().includes(q)){
      results.push({icon:'💰',iconBg:'#fff7ed',label:b.dept,sub:b.cat+' · '+b.period,panel:'fin-budget',cat:'Budgets'});
    }
  });
  // Expenses
  (expenses||[]).forEach(function(x){
    if(x.emp&&x.emp.toLowerCase().includes(q)||x.desc&&x.desc.toLowerCase().includes(q)||x.cat&&x.cat.toLowerCase().includes(q)){
      results.push({icon:'💳',iconBg:'#fef2f2',label:x.emp||x.cat,sub:x.desc+' · '+fmtMoney(x.amount),panel:'fin-expenses',cat:'Expenses'});
    }
  });
  // Contracts
  (contracts||[]).forEach(function(c){
    if(c.name&&c.name.toLowerCase().includes(q)||c.dept&&c.dept.toLowerCase().includes(q)){
      results.push({icon:'📄',iconBg:'#f0f9ff',label:c.name,sub:c.dept+' · ends '+fmtDate(c.end),panel:'hr-contracts',cat:'Contracts'});
    }
  });
  // Payroll
  (payroll||[]).forEach(function(p){
    if(p.name&&p.name.toLowerCase().includes(q)||p.dept&&p.dept.toLowerCase().includes(q)){
      results.push({icon:'💵',iconBg:'#f0fdf4',label:p.name,sub:p.dept+' · Net: '+fmtMoney(p.base-p.ded),panel:'hr-payroll',cat:'Payroll'});
    }
  });
  // Announcements
  (announcements||[]).forEach(function(a){
    if(a.title&&a.title.toLowerCase().includes(q)||a.body&&a.body.toLowerCase().includes(q)){
      results.push({icon:'📌',iconBg:'#fffbeb',label:a.title,sub:a.body.slice(0,60),panel:'exec',cat:'Announcements'});
    }
  });
  if(!results.length){r.innerHTML='<div class="gsearch-empty">No results for "'+escH(q)+'"</div>';return;}
  // Group by category
  var cats={};
  results.slice(0,30).forEach(function(res){if(!cats[res.cat])cats[res.cat]=[];cats[res.cat].push(res);});
  var html='';
  Object.keys(cats).forEach(function(cat){
    html+='<div class="gsearch-section">'+cat+'</div>';
    cats[cat].forEach(function(res){
      html+='<div class="gsearch-item" onclick="closeGSearch();navTo(\''+res.panel+'\',document.querySelector(\'[data-p=\\\"'+res.panel+'\\\"]\'))">'+
        '<div class="gsearch-item-icon" style="background:'+res.iconBg+'">'+res.icon+'</div>'+
        '<div class="gsearch-item-text"><div class="gsearch-item-title">'+escH(res.label)+'</div><div class="gsearch-item-sub">'+escH(res.sub)+'</div></div>'+
        '<div class="gsearch-item-panel">'+cat+'</div>'+
      '</div>';
    });
  });
  r.innerHTML=html;
}

