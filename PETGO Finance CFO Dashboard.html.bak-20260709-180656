function restoreBackup(evt){
  var file=evt.target.files[0];if(!file)return;
  var reader=new FileReader();
  reader.onload=function(e){
    try{
      var backup=JSON.parse(e.target.result);
      if(!backup.data){showToast('Invalid backup file.');return;}
      if(!confirm('This will overwrite all current data. Continue?'))return;
      BK_KEYS.forEach(function(k){if(backup.data[k]!==undefined)fnSave(k,backup.data[k]);});
      // Reload data
      budgets=fnLoad('petgo_budgets',[]);invoices=fnLoad('petgo_invoices',[]);pettyCash=fnLoad('petgo_petty',[]);
      projects=fnLoad('petgo_projects',[]);expenses=fnLoad('petgo_expenses',[]);leaves=fnLoad('petgo_leaves',[]);
