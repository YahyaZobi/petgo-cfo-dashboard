function saveInv(){
  var vendor=document.getElementById('inv-f-vendor').value.trim();
  var amount=parseFloat(document.getElementById('inv-f-amount').value)||0;
  if(!vendor){showToast('Vendor name is required.');return;}
  var i={id:invEditIdx>=0?invoices[invEditIdx].id:fnId(),vendor:vendor,desc:document.getElementById('inv-f-desc').value.trim(),amount:amount,issue:document.getElementById('inv-f-issue').value,due:document.getElementById('inv-f-due').value,status:document.getElementById('inv-f-status').value};
