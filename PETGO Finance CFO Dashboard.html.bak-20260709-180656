<script>
(function () {
  var form        = document.getElementById('vantage-login-form');
  var emailInput  = document.getElementById('vantage-login-email');
  var pwInput     = document.getElementById('vantage-login-password');
  var pwToggle    = document.getElementById('vantage-login-pw-toggle');
  var errorBox    = document.getElementById('vantage-login-error');
  var errorText   = document.getElementById('vantage-login-error-text');
  var rememberBox = document.getElementById('vantage-login-remember');
  var forgotLink  = document.getElementById('vantage-login-forgot');

  var savedEmail = localStorage.getItem('petgo_login_email');
  if (savedEmail) emailInput.value = savedEmail;

  function showError(msg) {
    errorText.textContent = msg;
    errorBox.classList.add('is-visible');
  }
  function clearError() {
    errorBox.classList.remove('is-visible');
    errorText.textContent = '';
  }

  emailInput.addEventListener('input', clearError);
  pwInput.addEventListener('input', clearError);

  pwToggle.addEventListener('click', function () {
    var isPw = pwInput.type === 'password';
    pwInput.type = isPw ? 'text' : 'password';
    pwToggle.querySelector('.vantage-eye-on').style.display  = isPw ? 'none' : 'block';
    pwToggle.querySelector('.vantage-eye-off').style.display = isPw ? 'block' : 'none';
  });

  forgotLink.addEventListener('click', function (e) { e.preventDefault(); });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var email    = emailInput.value.trim();
    var password = pwInput.value;
    var remember = rememberBox.checked;

    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError('Please enter a valid email address.');
      return;
    }
    if (!password) {
      showError('Please enter your password.');
      return;
    }
    clearError();

    // Hands off to the app's login() (ALLOWED-domain check, then bootApp).
    if (typeof window.login === 'function') {
      window.login(email, password, remember);
    } else {
      console.log('login()', { email: email, remember: remember });
    }
  });
})();
</script>

