function saveEmp(){
  var name=document.getElementById('emp-f-name').value.trim();
  if(!name){showToast('Full name is required.');document.getElementById('emp-f-name').focus();return;}
  // Resolve photo: pending upload → cleared → existing → none
  var existingPhoto=(empEditIdx>=0&&employees[empEditIdx].photo)||'';
  var finalPhoto=empPendingPhoto==='__clear__'?'':(empPendingPhoto||existingPhoto);
  var newId=empEditIdx>=0?employees[empEditIdx].id:empNextId++;
  var empId=document.getElementById('emp-f-empid').value.trim()||('PTG-'+String(newId).padStart(3,'0'));
  var emp={
    id:newId,
    empId:empId,
    name:name,
    title:document.getElementById('emp-f-title').value.trim(),
    dept:document.getElementById('emp-f-dept').value.trim(),
    email:document.getElementById('emp-f-email').value.trim(),
    phone:document.getElementById('emp-f-phone').value.trim(),
    photo:finalPhoto
  };
  if(empEditIdx>=0){employees[empEditIdx]=emp;showToast(name+' updated.');}
  else{employees.push(emp);showToast(name+' added to the directory.');}
  saveEmployeeStore();
  closeEmpModal();
  renderEmpGrid();
  // Refresh header photo if the saved employee is the logged-in user
  refreshCurrentUserPhoto();
}

function deleteEmp(idx){
  var emp=employees[idx];
  if(!emp)return;
  if(!confirm('Remove '+emp.name+' from the team directory?'))return;
  var name=emp.name;
  employees.splice(idx,1);
  saveEmployeeStore();
  renderEmpGrid();
  showToast(name+' removed.');
}

