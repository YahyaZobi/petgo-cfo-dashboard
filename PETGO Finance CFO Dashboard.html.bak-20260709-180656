}
function _saveLinkForm(mod){
  var pathEl=document.getElementById('ds-inp-path-'+mod);
  var sheetEl=document.getElementById('ds-inp-sheet-'+mod);
  var path=(pathEl?pathEl.value:'').trim();
  var sheet=(sheetEl?sheetEl.value:'').trim();
  if(!_dsConfig.sources)_dsConfig.sources={};
  if(!_dsConfig.sources[mod])_dsConfig.sources[mod]={};
  _dsConfig.sources[mod].path=path;
  _dsConfig.sources[mod].sheet=sheet;
  _dsConfig.sources[mod].enabled=!!path;
  saveDSConfig();
  renderDSPanel();
  if(path&&_graphToken){showToast('File linked. Syncing '+DS_LABELS[mod]+'...');fetchModule(mod).then(function(){renderDSPanel();});}
  else if(path){showToast(DS_LABELS[mod]+' file saved. Sign in with Microsoft to sync.');}
}
function loginMS(){
  if(!_initMSAL()){showToast('Azure credentials not configured yet. Open Admin Setup and enter your Client ID and Tenant ID first.');return;}
  var req={scopes:['User.Read','Files.Read.All','Sites.Read.All']};
  _msalInstance.loginPopup(req).then(function(resp){
    _graphToken=resp.accessToken;
    GRAPH_MODE=true;
    localStorage.setItem('petgo_graph_mode','true');
    _updateAPIBadge(true);
    renderDSPanel();
    showToast('Connected to Microsoft 365. Data sources are now live.');
  }).catch(function(e){showToast('Sign-in was cancelled or failed: '+e.message);});
}

