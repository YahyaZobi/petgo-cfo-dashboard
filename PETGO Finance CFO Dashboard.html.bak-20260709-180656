// ── PHOTO CROP ENGINE ─────────────────────────────────
var empPendingPhoto='';
var cropState={scale:1,offX:0,offY:0,dragging:false,startX:0,startY:0,startOX:0,startOY:0,naturalW:0,naturalH:0};
var CROP_SIZE=220; // px, must match .crop-viewport size

function handleEmpPhotoUpload(input){
  var file=input.files[0]; if(!file)return;
  if(!file.type.startsWith('image/')){showToast('Please select an image file.');return;}
  var reader=new FileReader();
  reader.onload=function(e){openCropModal(e.target.result);};
  reader.readAsDataURL(file);
  input.value='';
}

function openCropModal(src){
  var modal=document.getElementById('crop-modal');
  var img=document.getElementById('crop-img');
  var slider=document.getElementById('crop-zoom-slider');
  img.onload=function(){
    cropState.naturalW=img.naturalWidth;
    cropState.naturalH=img.naturalHeight;
    // Initial scale: cover the viewport circle
    var minScale=Math.max(CROP_SIZE/cropState.naturalW, CROP_SIZE/cropState.naturalH);
    cropState.scale=minScale;
    slider.min=minScale;
    slider.max=Math.max(minScale*3, 3);
    slider.step=minScale*0.01;
    slider.value=minScale;
    // Center
    cropState.offX=(CROP_SIZE - cropState.naturalW*cropState.scale)/2;
    cropState.offY=(CROP_SIZE - cropState.naturalH*cropState.scale)/2;
    applyCropTransform();
  };
  img.src=src;
  modal.classList.add('open');
}

function closeCropModal(){
  document.getElementById('crop-modal').classList.remove('open');
}

function applyCropTransform(){
  var img=document.getElementById('crop-img');
  img.style.transform='translate('+cropState.offX+'px,'+cropState.offY+'px) scale('+cropState.scale+')';
  img.style.transformOrigin='0 0';
  img.style.width=cropState.naturalW+'px';
  img.style.height=cropState.naturalH+'px';
}

function cropClampOffset(){
  var w=cropState.naturalW*cropState.scale;
  var h=cropState.naturalH*cropState.scale;
  if(w>=CROP_SIZE){cropState.offX=Math.min(0,Math.max(CROP_SIZE-w,cropState.offX));}
  else{cropState.offX=(CROP_SIZE-w)/2;}
  if(h>=CROP_SIZE){cropState.offY=Math.min(0,Math.max(CROP_SIZE-h,cropState.offY));}
  else{cropState.offY=(CROP_SIZE-h)/2;}
}

function cropZoomChange(val){
  val=parseFloat(val);
  // Keep center point stable during zoom
  var cx=CROP_SIZE/2, cy=CROP_SIZE/2;
  var imgX=(cx-cropState.offX)/cropState.scale;
  var imgY=(cy-cropState.offY)/cropState.scale;
  cropState.scale=val;
  cropState.offX=cx-imgX*cropState.scale;
  cropState.offY=cy-imgY*cropState.scale;
  cropClampOffset();
  applyCropTransform();
}

function cropDragStart(e){
  cropState.dragging=true;
  cropState.startX=e.clientX; cropState.startY=e.clientY;
  cropState.startOX=cropState.offX; cropState.startOY=cropState.offY;
  e.preventDefault();
}
function cropDragMove(e){
  if(!cropState.dragging)return;
  cropState.offX=cropState.startOX+(e.clientX-cropState.startX);
  cropState.offY=cropState.startOY+(e.clientY-cropState.startY);
  cropClampOffset();
  applyCropTransform();
}
function cropDragEnd(){cropState.dragging=false;}

function cropTouchStart(e){
  var t=e.touches[0];
  cropState.dragging=true;
  cropState.startX=t.clientX; cropState.startY=t.clientY;
  cropState.startOX=cropState.offX; cropState.startOY=cropState.offY;
  e.preventDefault();
}
function cropTouchMove(e){
  if(!cropState.dragging)return;
  var t=e.touches[0];
  cropState.offX=cropState.startOX+(t.clientX-cropState.startX);
  cropState.offY=cropState.startOY+(t.clientY-cropState.startY);
  cropClampOffset();
  applyCropTransform();
  e.preventDefault();
}

function applyCrop(){
  var img=document.getElementById('crop-img');
  var canvas=document.createElement('canvas');
  var OUT=240;
  canvas.width=OUT; canvas.height=OUT;
  var ctx=canvas.getContext('2d');
  // Clip to circle
  ctx.beginPath(); ctx.arc(OUT/2,OUT/2,OUT/2,0,Math.PI*2); ctx.clip();
  // Draw: map viewport top-left (-offX/-offY) to canvas, scaled
  var ratio=OUT/CROP_SIZE;
  ctx.drawImage(img,
    (-cropState.offX/cropState.scale), (-cropState.offY/cropState.scale),
    CROP_SIZE/cropState.scale, CROP_SIZE/cropState.scale,
    0, 0, OUT, OUT
  );
  empPendingPhoto=canvas.toDataURL('image/jpeg',0.88);
  // Update modal preview
  var preview=document.getElementById('emp-photo-preview');
  var initEl=document.getElementById('emp-photo-initials');
  var ring=document.getElementById('emp-photo-ring');
  if(preview){preview.src=empPendingPhoto;preview.style.display='block';}
  if(initEl)initEl.style.display='none';
  if(ring)ring.style.background='transparent';
  closeCropModal();
}
function clearEmpPhoto(){
  empPendingPhoto='__clear__'; // sentinel: explicitly removed
  var preview=document.getElementById('emp-photo-preview');
  var initEl=document.getElementById('emp-photo-initials');
  var ring=document.getElementById('emp-photo-ring');
  if(preview){preview.src='';preview.style.display='none';}
  if(initEl){initEl.textContent=empInitials(document.getElementById('emp-f-name').value||'?');initEl.style.display='';}
