        '<div class="org-dept-pill" style="background:'+color+'18;color:'+color+';border-color:'+color+'30;">'+escH(dept)+' <span style="opacity:.55;font-weight:600;">('+depts[dept].length+')</span></div>'+
        depts[dept].map(function(e){
          return '<div class="org-emp-card">'+
            av(e,'org-av-sm')+
            '<div class="org-emp-name">'+escH(e.name)+'</div>'+
            '<div class="org-emp-title">'+escH(e.title||'—')+'</div>'+
            (e.empId?'<div class="org-emp-id">'+escH(e.empId)+'</div>':'')+
          '</div>';
        }).join('')+
