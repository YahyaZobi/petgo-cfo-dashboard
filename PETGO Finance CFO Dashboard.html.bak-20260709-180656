var invEditIdx=-1; var invFilter='All';
function saveInvStore(){fnSave('petgo_invoices',invoices);}
function renderInvoices(){
  var total=invoices.reduce(function(s,i){return s+(i.status!=='Paid'?i.amount:0);},0);
  var overdue=invoices.filter(function(i){return i.status==='Overdue';}).reduce(function(s,i){return s+i.amount;},0);
  var paid=invoices.filter(function(i){return i.status==='Paid';}).reduce(function(s,i){return s+i.amount;},0);
  var pending=invoices.filter(function(i){return i.status==='Pending';}).length;
  document.getElementById('inv-kpis').innerHTML=
    fnKpi('Outstanding',fmtMoney(total),'Unpaid invoices','#fef9c3','#854d0e','!')+
    fnKpi('Overdue',fmtMoney(overdue),'Past due date','#fee2e2','#991b1b','⚠')+
    fnKpi('Pending Count',pending+' invoices','Awaiting payment','#dbeafe','#1d4ed8','…')+
    fnKpi('Paid This Period',fmtMoney(paid),'Settled','#dcfce7','#15803d','✓');
  filterInv(invFilter);
}
function filterInv(f,el){
  invFilter=f;
  if(el){document.querySelectorAll('#panel-fin-invoices .fn-filter').forEach(function(x){x.classList.remove('active');});el.classList.add('active');}
  var list=f==='All'?invoices:invoices.filter(function(i){return i.status===f;});
  var tb=document.getElementById('inv-tbody'); if(!tb)return;
  if(!list.length){tb.innerHTML='<tr><td colspan="7" class="fn-empty">No invoices found.</td></tr>';return;}
  tb.innerHTML=list.map(function(inv){
    var idx=invoices.indexOf(inv);
    var bc=inv.status==='Paid'?'fn-paid':inv.status==='Overdue'?'fn-overdue':'fn-pending';
