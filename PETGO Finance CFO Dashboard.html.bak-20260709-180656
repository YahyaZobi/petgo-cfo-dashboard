      announcements=fnLoad('petgo_announcements',[]);reviews=fnLoad('petgo_reviews',[]);
      addAudit('Restore','Data restored from backup: '+file.name,'#f59e0b');
      showToast('Data restored successfully. Refresh panels to see changes.');
    }catch(ex){showToast('Invalid backup file: '+ex.message);}
  };
  reader.readAsText(file);
}
