// ── SMART VISUALIZATION ENGINE ──────────────────────

var MAX_CHART_PTS=300; // max rows used for charting (performance)
var TABLE_PAGE=50;

/* Detect " — " pivot format and return {headers, rows, entityCount} or null */
function tryUnpivot(rawH,rawR){
  var seps=[' — ',' – ',' ‒ ',' - '];
  for(var si=0;si<seps.length;si++){
    var sep=seps[si];
    var mt=rawH.filter(function(h){return h.indexOf(sep)>0;});
    if(mt.length<3||mt.length<rawH.length*0.5)continue;
    var eMap={},fieldOrder=[];
    rawH.forEach(function(h,i){
      var p=h.indexOf(sep); if(p<0)return;
      var ent=h.slice(0,p).trim(),fld=h.slice(p+sep.length).trim();
      if(!eMap[ent])eMap[ent]={};
      eMap[ent][fld]=i;
      if(fieldOrder.indexOf(fld)<0)fieldOrder.push(fld);
    });
    var entities=Object.keys(eMap); if(entities.length<2)continue;
    var newRows=[];
    rawR.forEach(function(row){
      entities.forEach(function(ent){
        var rec=[ent];
        fieldOrder.forEach(function(fld){
          var ci=(eMap[ent]&&eMap[ent][fld]!=null)?eMap[ent][fld]:-1;
          rec.push(ci>=0?row[ci]:null);
        });
        newRows.push(rec);
      });
    });
    return{headers:['Name'].concat(fieldOrder),rows:newRows,entityCount:entities.length};
  }
  return null;
}

/* Classify a column based on its name and values */
function analyzeCol(name,idx,rows){
  var n=String(name||'').toLowerCase();
  var vals=rows.map(function(r){return r[idx];}).filter(function(v){return v!=null&&String(v).trim()!=='';});
  var nums=vals.map(parseFloat).filter(function(v){return !isNaN(v)&&isFinite(v);});
  var pNum=nums.length/Math.max(vals.length,1);
  var uniq=[]; var seen={};
  vals.forEach(function(v){var s=String(v);if(!seen[s]){seen[s]=1;uniq.push(s);}});
  var sum=nums.reduce(function(a,b){return a+b;},0);
  var mx=nums.length?Math.max.apply(null,nums):0;
  var mn=nums.length?Math.min.apply(null,nums):0;
  var avg=nums.length?sum/nums.length:0;
  var type='text';
  if(pNum>0.7){
    if(mx>2e10||/phone|mobile|tel/.test(n))type='phone';
    else if(/\bid\b|_id$|^id_/.test(n)&&avg>1000)type='id';
    else if(/date|week|month|qtr|quarter|year|period/.test(n)&&mx<10000&&avg<2000)type='ordinal';
    else if(/%|pct|percent|rate|ratio|margin/.test(n)||(mx<=100&&avg>0&&avg<=100&&mn>=0))type='pct';
    else type='amount';
  }else{type=uniq.length<=30?'category':'label';}
  return{idx:idx,name:name,n:n,type:type,
    isNum:pNum>0.7,nums:nums,uniq:uniq,
    sum:sum,mx:mx,mn:mn,avg:avg,count:vals.length,
    isID:type==='id'||type==='phone',
    isMeasure:type==='amount'||type==='pct',
    isOrdinal:type==='ordinal',
    isCat:type==='category',
    isTime:/date|week|month|year|qtr|quarter|period/.test(n)};
}

function takeSample(rows,max){
  if(rows.length<=max)return rows;
  var step=Math.ceil(rows.length/max),out=[];
  for(var i=0;i<rows.length;i+=step)out.push(rows[i]);
  return out.slice(0,max);
}

function buildSheetViz(sn,data,canvasIds){
  var rawH=(data[0]||[]).map(function(h){return String(h!=null?h:'');});
  var rawR=data.slice(1).filter(function(r){return r&&r.some(function(v){return v!=null&&v!=='';});});
  if(!rawR.length)return null;

  // Pivot detection
  var pv=tryUnpivot(rawH,rawR);
  var H=pv?pv.headers:rawH;
  var R=pv?pv.rows:rawR;
  if(R.length>5000)R=R.slice(0,5000); // hard cap for DOM safety
  var sample=takeSample(R,MAX_CHART_PTS);

  // Analyze columns on sample
  var cols=H.map(function(h,i){return analyzeCol(h,i,sample);});

  var wrap=document.createElement('div');
  wrap.style.marginBottom='24px';

  // Title
  var tEl=document.createElement('div'); tEl.className='gen-sheet-t';
  tEl.innerHTML='<div class="gen-sheet-dot"></div>'+escH(sn)+
    (pv?'<span class="badge bb" style="font-size:10px;margin-left:8px;vertical-align:middle;">'+pv.entityCount.toLocaleString()+' records (auto-organized)</span>':'');
  wrap.appendChild(tEl);

