    '<div><div class="ntext">'+escH(body)+'</div><div class="ntime">Just now</div></div>';
  list.insertBefore(item,list.firstChild);
  unread++; updateBadge();
}

function sendEmailAlert(type){
  if(!emailPrefs.all){showToast('Email notifications are disabled.');return;}
  var def=EMAIL_DEFS[type]; if(!def)return;
  var to=currentUser||'';
  var url='https://outlook.office.com/mail/new?to='+encodeURIComponent(to)+
