function buildKPIRow(cols,rows,parent){
  var measures=cols.filter(function(c){return c.isMeasure&&!c.isID&&c.nums.length;});
  var row=document.createElement('div');
  row.className='gen-kpi-row'; row.style.marginBottom='14px';

  // Total records always first
  addKPI(row,'Total Records',rows.length.toLocaleString(),'#2B7FE8','');

  measures.slice(0,4).forEach(function(c,i){
    addKPI(row,c.name,sFmt(c.sum,c.n),CLRS[i],'sum · avg '+sFmt(c.avg,c.n));
  });

  // Category unique counts
  cols.filter(function(c){return c.isCat&&!c.isID;}).slice(0,2).forEach(function(c){
    addKPI(row,c.name,c.uniq.length+' unique','#8b5cf6','distinct values');
  });

  if(row.children.length)parent.appendChild(row);
}

function addKPI(parent,label,value,color,sub){
  var el=document.createElement('div'); el.className='gen-kpi';
  el.innerHTML='<div class="gen-kpi-l">'+escH(String(label))+'</div>'+
    '<div class="gen-kpi-v" style="color:'+color+'">'+escH(String(value))+'</div>'+
    (sub?'<div style="font-size:10px;color:var(--tm);margin-top:3px;">'+escH(String(sub))+'</div>':'');
  parent.appendChild(el);
}

function buildSmartCharts(cols,rows,prefix,parent,canvasIds){
  var measures=cols.filter(function(c){return c.isMeasure&&!c.isID&&c.nums.length;});
  var cats=cols.filter(function(c){return c.isCat&&!c.isID;});
  var ordinals=cols.filter(function(c){return c.isOrdinal;});
  var labels=cols.filter(function(c){return(c.isCat||c.type==='label')&&!c.isID;});
  var pfx='dyn_'+dynCC+'_';

  var configs=[];

  // 1. Ordinal distribution (e.g. BLOCK DATE with values 1,2,3) → bar
  ordinals.forEach(function(col){
    var freq={};
    rows.forEach(function(r){
      var v=r[col.idx]; if(v==null||v==='')return;
      var k=String(v); freq[k]=(freq[k]||0)+1;
    });
    var entries=Object.keys(freq).map(function(k){return[k,freq[k]];})
      .sort(function(a,b){return parseFloat(a[0])-parseFloat(b[0]);});
    if(entries.length>1)configs.push({
      title:col.name+' Distribution',
      cfg:{type:'bar',data:{labels:entries.map(function(e){return e[0];}),
        datasets:[{label:'Count',data:entries.map(function(e){return e[1];}),
        backgroundColor:CLRS.slice(0,entries.length).map(function(c){return c+'cc';}),borderRadius:6}]},
        options:{responsive:true,maintainAspectRatio:false,
          plugins:{legend:{display:false}},
          scales:{x:{grid:{display:false},ticks:{font:{size:10}}},
                  y:{ticks:{stepSize:1,font:{size:10}}}}}}
    });
  });

  // 2. Category + measure aggregation → pie (≤8) or horizontal bar (>8)
  if(cats.length>0&&measures.length>0){
    var cat=cats[0],meas=measures[0];
    var agg={};
    rows.forEach(function(r){
      var k=String(r[cat.idx]!=null?r[cat.idx]:'Unknown');
      var v=parseFloat(r[meas.idx]); if(!isNaN(v))agg[k]=(agg[k]||0)+v;
    });
    var entries=Object.keys(agg).map(function(k){return[k,agg[k]];})
      .sort(function(a,b){return b[1]-a[1];}).slice(0,15);
    if(entries.length>=2){
      if(entries.length<=8){
        configs.push({title:meas.name+' by '+cat.name,cfg:{type:'doughnut',
          data:{labels:entries.map(function(e){return e[0];}),
            datasets:[{data:entries.map(function(e){return e[1];}),
            backgroundColor:CLRS.slice(0,entries.length),borderWidth:2,borderColor:'var(--card)'}]},
          options:{responsive:true,maintainAspectRatio:false,cutout:'60%',
            plugins:{legend:{position:'right',labels:{font:{size:10},boxWidth:10,padding:6}}}}}});
      }else{
        configs.push({title:meas.name+' by '+cat.name+' (Top 15)',cfg:{type:'bar',
          data:{labels:entries.map(function(e){return e[0].slice(0,20);}),
            datasets:[{label:meas.name,data:entries.map(function(e){return e[1];}),
            backgroundColor:'#3b82f6',borderRadius:4}]},
          options:{responsive:true,maintainAspectRatio:false,indexAxis:'y',
            plugins:{legend:{display:false}},
            scales:{x:{ticks:{font:{size:9}}},y:{ticks:{font:{size:9}}}}}}});
      }
    }
  }

  // 3. Time series → line chart
  var timeCols=cols.filter(function(c){return c.isTime&&c.isMeasure;});
  if(timeCols.length===0&&cols.some(function(c){return c.isTime&&!c.isID;})){
    var tc=cols.filter(function(c){return c.isTime&&!c.isID;})[0];
    if(measures.length>0){
      // Sort by time axis values, plot first 2 measures
      var tLabels=rows.map(function(r){return String(r[tc.idx]!=null?r[tc.idx]:'');});
      configs.push({title:'Trend: '+tc.name,cfg:{type:'line',
        data:{labels:tLabels,
          datasets:measures.slice(0,2).map(function(m,i){return{
            label:m.name,data:rows.map(function(r){return parseFloat(r[m.idx])||0;}),
            borderColor:CLRS[i],backgroundColor:'rgba(59,130,246,0.07)',
            fill:i===0&&measures.length===1,tension:0.35,pointRadius:2};})},
        options:{responsive:true,maintainAspectRatio:false,
          plugins:{legend:{position:'top',labels:{font:{size:10},boxWidth:10}}},
          scales:{x:{grid:{display:false},ticks:{maxTicksLimit:12,font:{size:9}}},
                  y:{ticks:{font:{size:9}}}}}}});
    }
  }

  // 4. Multiple measures overview → bar
  if(measures.length>=2&&!configs.some(function(c){return c.cfg.type==='bar'&&!c.cfg.options.indexAxis;})){
    configs.push({title:'Metrics Overview',cfg:{type:'bar',
      data:{labels:measures.slice(0,8).map(function(c){return c.name.slice(0,18);}),
        datasets:[{label:'Total',data:measures.slice(0,8).map(function(c){return c.sum;}),
        backgroundColor:CLRS.slice(0,8),borderRadius:5}]},
      options:{responsive:true,maintainAspectRatio:false,
        plugins:{legend:{display:false}},
        scales:{x:{grid:{display:false},ticks:{font:{size:9}}},
                y:{ticks:{font:{size:9}}}}}}});
  }

  // 5. Label + one measure
  if(!configs.length&&labels.length>0&&measures.length>0){
    var lc=labels[0],mc=measures[0];
    var lrows=rows.slice(0,20);
    configs.push({title:mc.name+' by '+lc.name,cfg:{type:'bar',
      data:{labels:lrows.map(function(r){return String(r[lc.idx]||'').slice(0,15);}),
        datasets:[{label:mc.name,data:lrows.map(function(r){return parseFloat(r[mc.idx])||0;}),
        backgroundColor:'#3b82f6',borderRadius:4}]},
      options:{responsive:true,maintainAspectRatio:false,
        plugins:{legend:{display:false}},
        scales:{x:{grid:{display:false},ticks:{font:{size:9}}},
                y:{ticks:{font:{size:9}}}}}}});
  }

  if(!configs.length)return;

  var grid=document.createElement('div');
  grid.style.cssText='display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;';

  configs.slice(0,4).forEach(function(c,ci){
    var cvId=pfx+'c'+ci; if(canvasIds)canvasIds.push(cvId);
    var card=document.createElement('div'); card.className='card';
    var ct=document.createElement('div'); ct.className='card-t'; ct.textContent=c.title;
    var cw=document.createElement('div'); cw.style.cssText='position:relative;height:230px;';
    var cv=document.createElement('canvas'); cv.id=cvId;
    cv.setAttribute('data-cfg',JSON.stringify(c.cfg));
    cw.appendChild(cv); card.appendChild(ct); card.appendChild(cw);
    grid.appendChild(card);
  });
  dynCC++;
  parent.appendChild(grid);
}

function buildPagedTable(headers,rows,title){
  var PAGE=TABLE_PAGE, page=0, filtered=rows;
  var wrap=document.createElement('div'); wrap.className='card'; wrap.style.marginBottom='8px';

  var topRow=document.createElement('div');
  topRow.style.cssText='display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:8px;';
  var lbl=document.createElement('div'); lbl.className='card-t'; lbl.style.margin='0';
  lbl.textContent=escH(title)+' — '+rows.length.toLocaleString()+' rows';
  var srch=document.createElement('input'); srch.type='text'; srch.className='tbl-search';
  srch.placeholder='Search…';
  topRow.appendChild(lbl); topRow.appendChild(srch); wrap.appendChild(topRow);

  var tWrap=document.createElement('div'); tWrap.className='tbl-scroll';
  var tbl=document.createElement('table'); tbl.className='tbl';
  tWrap.appendChild(tbl); wrap.appendChild(tWrap);

  var pgWrap=document.createElement('div'); pgWrap.className='pg-wrap';
  var pgInfo=document.createElement('span'); pgInfo.className='pg-info';
  var pgBtns=document.createElement('div'); pgBtns.className='pg-btns';
  var prev=document.createElement('button'); prev.className='page-btn'; prev.textContent='← Prev';
  var next=document.createElement('button'); next.className='page-btn'; next.textContent='Next →';
  pgBtns.appendChild(prev); pgBtns.appendChild(next);
  pgWrap.appendChild(pgInfo); pgWrap.appendChild(pgBtns); wrap.appendChild(pgWrap);

  function render(){
    var start=page*PAGE, slice=filtered.slice(start,start+PAGE);
    var hHtml='<thead><tr>'+headers.map(function(h){return'<th>'+escH(String(h||''))+'</th>';}).join('')+'</tr></thead>';
    var bHtml='<tbody>'+slice.map(function(row){
      return'<tr>'+headers.map(function(_,i){
        var v=row[i]!=null?String(row[i]):'';
        var isN=v!==''&&!isNaN(parseFloat(v));
        return'<td'+(isN?' style="font-variant-numeric:tabular-nums;"':'')+'>'+escH(v)+'</td>';
      }).join('')+'</tr>';
    }).join('')+'</tbody>';
    tbl.innerHTML=hHtml+bHtml;
    var from=filtered.length?start+1:0, to=Math.min(start+PAGE,filtered.length);
    pgInfo.textContent='Showing '+from+'–'+to+' of '+filtered.length.toLocaleString();
    prev.disabled=page===0; next.disabled=to>=filtered.length;
    prev.style.opacity=prev.disabled?'0.38':'1';
    next.style.opacity=next.disabled?'0.38':'1';
  }

  srch.oninput=function(){
    var q=this.value.toLowerCase(); page=0;
    filtered=q?rows.filter(function(r){return r.some(function(v){return String(v||'').toLowerCase().indexOf(q)>=0;});}):rows;
    render();
  };
  prev.onclick=function(){if(page>0){page--;render();}};
  next.onclick=function(){if((page+1)*PAGE<filtered.length){page++;render();}};

  render();
  return wrap;
}

function sFmt(v,col){
  var cn=String(col||'').toLowerCase();
  if(/phone|mobile|tel/.test(cn)||Math.abs(v)>2e9)return String(Math.round(v));
  if(/\bid\b|_id/.test(cn))return Math.round(v).toLocaleString();
  if(/%|pct|percent|rate|margin/.test(cn))return(Math.round(v*10)/10)+'%';
  if(/\$|revenue|cost|profit|cash|salary|income|expense|budget|amount|backlog|capital/.test(cn)||Math.abs(v)>=10000)
    return fmtMoney(v);
  return(Math.round(v*100)/100).toLocaleString();
}

